<?php

namespace {{ namespace }};

use EduLazaro\Larascraper\Scraper;
use EduLazaro\Larascraper\Support\ScraperResponse;

/**
 * Scrapes a page and returns the parsed data.
 */
class {{ class }} extends Scraper
{
    /**
     * Fetch the page and return the scraped result.
     *
     * The default below just returns the fetched HTML wrapped in a
     * ScraperResponse. To parse structured data, chain a crawler:
     *
     *     // Parse with a dedicated Crawler class:
     *     return $this->scrape($url)->crawl(YourCrawler::class)->run();
     *
     *     // Or extract inline by CSS selector:
     *     $titles = $this->scrape($url)->crawl('.selector')->texts();
     *
     * @param  string  $url  The URL to fetch.
     * @return \EduLazaro\Larascraper\Support\ScraperResponse
     */
    protected function handle(string $url): ScraperResponse
    {
        return $this->scrape($url)->run();
    }
}
